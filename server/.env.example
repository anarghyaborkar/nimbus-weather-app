# ──────────────────────────────────────────────
# Nimbus — Server Environment Variables
# ──────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file and rename the copy to: .env
#   2. Fill in your actual values (never commit .env to git)
# ──────────────────────────────────────────────

# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# The port the Express server will listen on
PORT=5000

# ── Nimbus AI Chat (optional) ──────────────────
# Enables Gemini-powered conversational responses.
# Get your free key at: https://aistudio.google.com/apikey
# If omitted, the assistant uses a rich local fallback engine instead.
GEMINI_API_KEY=your_gemini_key_here
